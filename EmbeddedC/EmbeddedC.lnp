--cpu Cortex-M3 "startup_lpc17xx.o" "led.o" "system_lpc17xx.o" 
--library_type=microlib --strict --scatter "EmbeddedC.sct" 
--summary_stderr --info summarysizes --map --xref --callgraph --symbols 
--info sizes --info totals --info unused --info veneers 
 --list ".\EmbeddedC.map" -o EmbeddedC.axf